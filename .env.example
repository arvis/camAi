# Copy to .env and fill in your values

# Slack / Mattermost webhook URLs
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/XXX/XXX    # event alerts
SLACK_REPORTING_URL=https://hooks.slack.com/services/XXX/XXX/XXX  # AI situation reports (falls back to SLACK_WEBHOOK_URL if unset)

# LLM provider (openai | anthropic | gemini | ollama)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...  # required when LLM_PROVIDER=gemini
